# ===== Server =====
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ===== Database (free: MongoDB Community self-hosted or Atlas M0) =====
MONGO_URI=mongodb://127.0.0.1:27017/exam_eval

# ===== JWT auth =====
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=8h

# ===== Redis (free: self-hosted) for BullMQ scoring queue =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ===== Python AI microservice (free: local FastAPI) =====
AI_SERVICE_URL=http://127.0.0.1:8000
AI_TIMEOUT_MS=90000

# ===== Email (free: Gmail SMTP via Nodemailer, low volume) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ===== Logging =====
LOG_LEVEL=info

# ===== Worker / queue tuning =====
# Set to true on minimal deployments with no Redis (API scores inline)
REDIS_DISABLED=false
SCORING_CONCURRENCY=2
EMAIL_CONCURRENCY=3

# ---- Licensing (self-hosted) ----
# Public key (PEM) the app uses to verify licences. The matching private key is
# held only by the vendor. Without this, the app runs unlicensed.
# LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
#
# The institution's licence key (issued by the vendor). Can also be installed at
# runtime via the admin Licence screen.
# LICENSE_KEY=
#
# Turn enforcement on in production. When false (default), the app runs fully
# unlocked for development/evaluation.
# LICENSE_ENFORCE=false

# ---- Update server (vendor-run; optional) ----
# URL of your update/release server. The app checks it for new versions, but
# only when the licence is active (lapsed customers don't get updates). Leave
# blank if you don't run one yet.
# UPDATE_SERVER_URL=https://updates.youdomain.com

# ---- SaaS multi-tenancy (Phase 1) ----
# Control-plane database (tenant registry, subscriptions, super-admins). Holds NO
# academic data.
# CONTROL_DB_URI=mongodb://user:pass@host:27017/evalai_control
#
# Base URI for tenant databases (the per-tenant DB name is appended automatically).
# TENANT_DB_BASE_URI=mongodb://user:pass@host:27017
#
# Tenant connection pool tuning (optional)
# TENANT_CONN_IDLE_TTL_MS=900000
# TENANT_CONN_MAX_OPEN=50
#
# ---- Code execution provider (swappable) ----
# 'judge0' (self-run, isolated tier) or 'managed' (hosted third-party API)
# CODE_EXEC_PROVIDER=judge0
# CODE_EXEC_API_URL=
# CODE_EXEC_API_KEY=

# ---- Lambda code executor (CODE_EXEC_PROVIDER=lambda) ----
# AWS region where the executor Lambdas are deployed.
# AWS_REGION=ap-south-1
# Per-language Lambda function names (defaults shown).
# LAMBDA_EXEC_PYTHON=evalai-exec-python
# LAMBDA_EXEC_JAVA=evalai-exec-java
# LAMBDA_EXEC_C=evalai-exec-c
# LAMBDA_EXEC_CPP=evalai-exec-cpp
# The server needs AWS creds with lambda:InvokeFunction on these functions.
